# ==============================================================================
# Kynetic — Backend Environment Configuration Template (backend/.env.example)
# ==============================================================================
# Copy this file to `backend/.env` for local backend development.
# ==============================================================================

# Application & Network
APP_ENV=development
APP_NAME=Kynetic
API_V1_PREFIX=/api/v1
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (Default: Portable Local SQLite)
# Auto-created on startup with tables and 2,000+ validated questions.
DATABASE_URL=sqlite:///./kynetic_dev.db

# Authentication
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Provider Configuration (Google Gemini)
# Free key from https://aistudio.google.com/
# If left blank, Kynetic uses its built-in local deterministic AI engine.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_MODEL=gemini-2.5-flash

# Private File Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads

# GitHub OAuth Integration (Optional in development)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/integrations/github/callback

# Kynetic Backend Environment Configuration
APP_ENV=development
APP_NAME=Kynetic
API_V1_PREFIX=/api/v1
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Connection (Default: Portable Local SQLite)
# Automatically initialized and managed. No PostgreSQL server required.
DATABASE_URL=sqlite:///./kynetic_dev.db

# Authentication
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# AI Provider Configuration (Google Gemini)
# Obtain authorized development key from team lead. If left blank,
# Kynetic seamlessly uses the deterministic local fallback AI engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash

# Private File Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads

# GitHub OAuth Integration (Optional in development - structured fallbacks active)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/integrations/github/callback

# Kynetic Backend Environment Configuration
APP_ENV=development
APP_NAME=Kynetic
API_V1_PREFIX=/api/v1
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# Database Connection (PostgreSQL or fallback SQLite for testing)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/kynetic
# For local testing without PostgreSQL:
# DATABASE_URL=sqlite:///./kynetic_dev.db

# Authentication
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# AI Provider Configuration (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash

# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads

# GitHub Integration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/integrations/github/callback

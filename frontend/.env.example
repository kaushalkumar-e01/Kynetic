# API Base URL for backend communications
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Global toggle to use mock data for fallback
NEXT_PUBLIC_USE_MOCKS=false

# Per-module mock overrides (set true to force mock for a specific module)
NEXT_PUBLIC_MOCK_AUTH=false
NEXT_PUBLIC_MOCK_WORKSPACE=false
NEXT_PUBLIC_MOCK_RESUMES=false
NEXT_PUBLIC_MOCK_SKILLS=false
NEXT_PUBLIC_MOCK_ASSESSMENTS=false
NEXT_PUBLIC_MOCK_PROJECTS=false
NEXT_PUBLIC_MOCK_GOALS=false
NEXT_PUBLIC_MOCK_PLACEMENT=false
NEXT_PUBLIC_MOCK_ROADMAPS=false
NEXT_PUBLIC_MOCK_ASSISTANT=false
NEXT_PUBLIC_MOCK_INTEGRATIONS=false
NEXT_PUBLIC_MOCK_CODING_SANDBOX=false


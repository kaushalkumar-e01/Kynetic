# ==============================================================================
# Kynetic — Frontend Environment Configuration Template (frontend/.env.example)
# ==============================================================================
# Copy this file to `frontend/.env.local` for local frontend development.
# ==============================================================================

# API Base URL for backend communications (Required)
# The frontend auto-normalizes this URL and handles trailing slashes / prefixes.
# Examples:
#   http://localhost:8000/api/v1
#   http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Global toggle to use mock data for fallback (Default: false)
# When false, all requests communicate directly with the live FastAPI backend.
NEXT_PUBLIC_USE_MOCKS=false

# Per-module mock overrides (Set true only to force mock for a specific module during isolated UI development)
NEXT_PUBLIC_MOCK_AUTH=false
NEXT_PUBLIC_MOCK_WORKSPACE=false
NEXT_PUBLIC_MOCK_RESUMES=false
NEXT_PUBLIC_MOCK_SKILLS=false
NEXT_PUBLIC_MOCK_ASSESSMENTS=false
NEXT_PUBLIC_MOCK_PROJECTS=false
NEXT_PUBLIC_MOCK_GOALS=false
NEXT_PUBLIC_MOCK_PLACEMENT=false
NEXT_PUBLIC_MOCK_ROADMAPS=false
NEXT_PUBLIC_MOCK_ASSISTANT=false
NEXT_PUBLIC_MOCK_INTEGRATIONS=false
NEXT_PUBLIC_MOCK_CODING_SANDBOX=false

# ==============================================================================
# Kynetic — Environment Configuration Template (.env.example)
# ==============================================================================
# Instructions for new developers:
# 1. Backend: Copy this file to `backend/.env`
# 2. Frontend: Copy this file to `frontend/.env.local`
#
# Rule: Never commit real API keys, credentials, or private secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & BACKEND CONFIGURATION
# ------------------------------------------------------------------------------

# Runtime environment (Required)
# Options: development | test | production
# In development, CORS is open to local/LAN ports and SQLite auto-initializes.
APP_ENV=development

# Application branding name (Optional)
APP_NAME=Kynetic

# Base path prefix for all API v1 endpoints (Required)
API_V1_PREFIX=/api/v1

# Network bind host for FastAPI (Required)
# Use 127.0.0.1 for local isolation or 0.0.0.0 to expose to LAN devices.
BACKEND_HOST=127.0.0.1

# Network bind port for FastAPI (Required)
BACKEND_PORT=8000

# Canonical frontend web application origin (Required)
# Used by backend authentication and CORS response headers.
FRONTEND_ORIGIN=http://localhost:3000

# Additional allowed CORS origins (Optional, comma-separated)
# In development, loopback variants (127.0.0.1) and LAN IPs are auto-permitted.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------

# Database connection URL (Required)
# Default: Portable local SQLite database (`kynetic_dev.db`).
# Zero installation required — auto-initialized on first launch with 2,000+ questions.
# For production PostgreSQL: postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./kynetic_dev.db

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------

# JWT cryptographic signing key (Required)
# Generate a secure key in production with: `openssl rand -hex 32`
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# JWT algorithm (Required)
ALGORITHM=HS256

# JWT Access token lifespan in minutes (Required)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# 4. AI & LLM PROVIDER CONFIGURATION (Google Gemini)
# ------------------------------------------------------------------------------

# Primary LLM provider name (Required)
# Options: gemini | fallback
# When set to gemini:
#   - If GEMINI_API_KEY is provided, uses Google Gemini for live chat/analysis.
#   - If GEMINI_API_KEY is left blank, Kynetic smoothly uses its built-in local
#     deterministic engineering engine without crashing or hanging.
LLM_PROVIDER=gemini

# Google Gemini API Key (Optional in development, Recommended for live AI)
# Where to obtain: Free instant key from https://aistudio.google.com/
# Leave blank to run purely with local deterministic fallback.
GEMINI_API_KEY=

# Preferred Gemini model name (Optional)
# Recommended standard: gemini-2.5-flash (supported on all Google AI Studio accounts)
# Other options: gemini-flash-latest, gemini-1.5-flash, gemini-3.5-flash
GEMINI_MODEL=gemini-2.5-flash
LLM_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 5. LOCAL FILE STORAGE
# ------------------------------------------------------------------------------

# Storage provider type (Required)
# Options: local | s3
STORAGE_PROVIDER=local

# Local directory where uploaded resumes and artifacts are stored (Required)
STORAGE_LOCAL_DIR=./uploads

# ------------------------------------------------------------------------------
# 6. EXTERNAL INTEGRATIONS (Optional in development)
# ------------------------------------------------------------------------------

# GitHub OAuth integration for repository verification (Optional)
# Where to obtain: GitHub Settings -> Developer Settings -> OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/integrations/github/callback

# ------------------------------------------------------------------------------
# 7. FRONTEND CONFIGURATION (Used in frontend/.env.local)
# ------------------------------------------------------------------------------

# Target backend API base URL (Required for frontend)
# The frontend auto-normalizes this to append /api/v1 even if you omit it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Global mock data override (Optional, default: false)
# Set true only if developing frontend completely disconnected from backend.
NEXT_PUBLIC_USE_MOCKS=false

# Remote sandbox execution mock toggle (Optional, default: false)
NEXT_PUBLIC_MOCK_CODING_SANDBOX=false

# Copy to a local .env file when applications are implemented.
# Never commit real credentials or secret values.

# Backend
APP_ENV=development
APP_NAME=Kynetic
API_V1_PREFIX=/api/v1
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# Database — replace locally with your own development database URL.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/kynetic

# Authentication — generate a strong random secret locally before use.
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI provider — configure only the provider selected by the team.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Private file storage — implementation/provider to be selected.
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# GitHub OAuth/app — configure only after setup.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/integrations/github/callback

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

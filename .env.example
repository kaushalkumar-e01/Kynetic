# Kynetic Global Environment Configuration Example
# Copy to local .env in root, backend/.env, and frontend/.env.local
# Never commit real credentials, tokens, or secret keys.

# Backend Configuration
APP_ENV=development
APP_NAME=Kynetic
API_V1_PREFIX=/api/v1
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database — Portable local SQLite by default.
# Auto-initialized and populated with 2,000+ technical assessment questions.
DATABASE_URL=sqlite:///./kynetic_dev.db

# Authentication
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# AI Provider Configuration (Google Gemini)
# Obtain shared development API key from team lead.
# If left blank, Kynetic uses its built-in deterministic fallback AI engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash

# Private File Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads

# GitHub OAuth Integration (Optional in development)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/integrations/github/callback

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_USE_MOCKS=false
NEXT_PUBLIC_MOCK_CODING_SANDBOX=false
